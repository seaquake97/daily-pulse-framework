{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/daily-pulse-framework/config/schema.json",
  "$comment": "$id 用 .invalid 保留域名：schema 身份标识不应绑定具体 GitHub 组织或用户，换 owner 时无需改本文件。schema 是契约文档，rules.py 是执行体；两者对同一约束的表述必须一致，但本文件不参与运行时校验（纯标准库，无 jsonschema 依赖）。",
  "title": "daily-pulse-framework portfolio config",
  "description": "统一持仓数据仓契约 v2。双轨隔离结构：stock 轨收场内可交易标的（可网格、可做 T），fund 轨收场外基金（无挂单、无中间态，禁网格键），gold 单列实物/积存金。归属由 listing 字段决定，不由代码硬编码。硬约束 additionalProperties:false——拼写错误必须报错，不能静默生效。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile", "risk", "cash", "holdings"],
  "properties": {
    "version": {
      "description": "配置契约版本。v2 = 双轨隔离结构（ADR-007）。v1 三段结构不再支持读取。",
      "type": "integer",
      "enum": [2]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "base_currency", "mode"],
      "properties": {
        "owner": {
          "description": "配置归属人标识，仅用于产物署名与提交追踪，不参与任何计算。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "base_currency": {
          "description": "计价币种。当前 A 股/基金场景恒为 CNY。",
          "type": "string",
          "enum": ["CNY"]
        },
        "mode": {
          "description": "使用模式。personal = 个人自用存档；publishing = 对外发布研判内容（需完整免责）。",
          "type": "string",
          "enum": ["personal", "publishing"]
        },
        "note": {
          "description": "自由备注。不参与计算。",
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "risk": {
      "description": "风控参数段。ADR-007 §2.3：风控不撤，改为随每条建议下发，因此这些参数不允许缺省。",
      "type": "object",
      "additionalProperties": false,
      "required": ["max_single_position_pct", "max_total_drawdown_pct", "grid_step_pct_cap", "fund_holding_days_min"],
      "properties": {
        "max_single_position_pct": {
          "description": "单标的市值占总资产上限（%）。超过则禁止加仓建议。",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "max_total_drawdown_pct": {
          "description": "组合总回撤上限（%）。触及则建议降仓而非加仓。",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "grid_step_pct_cap": {
          "description": "网格步长上限（%）。单个标的的 step_pct 不得超过此值，防止过密网格。",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 50
        },
        "fund_holding_days_min": {
          "description": "场外基金赎回费免收窗口下限（天）。持有期不足此天数的标的不给卖出建议。",
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        }
      }
    },
    "cash": {
      "description": "现金段。加仓建议受可用现金约束，不能超出现金余额。",
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount"],
      "properties": {
        "currency": { "type": "string", "enum": ["CNY"] },
        "amount": {
          "description": "可用现金（元）。",
          "type": "number",
          "minimum": 0
        },
        "note": { "type": "string", "maxLength": 200 }
      }
    },
    "holdings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stock", "fund", "gold"],
      "properties": {
        "stock": { "$ref": "#/definitions/stockTrack" },
        "fund": { "$ref": "#/definitions/fundTrack" },
        "gold": {
          "description": "实物/积存金段。黄金不是基金，禁止混入 fund.positions——计入 fund_amount 会污染基金轨统计口径与赎回窗口判断。无黄金写 []。",
          "type": "array",
          "items": { "$ref": "#/definitions/goldItem" }
        }
      }
    }
  },
  "definitions": {
    "listing": {
      "description": "上市方式。exchange=场内可挂单（股票轨）；otc=场外申赎（基金轨）。归属由本字段决定，不由代码硬编码——ADR-007 §2.2。必填：留空会让「这只到底是场内还是场外」退化为隐式契约。",
      "type": "string",
      "enum": ["exchange", "otc"]
    },
    "exchangeCode": {
      "description": "6 位场内证券代码，不带市场前缀。解析器按前缀规则（60/68/9/50-58→sh，00/30/15/16/56→sz，4/8→bj）补全，与 codes.py 一致。",
      "type": "string",
      "pattern": "^(sh|sz|bj)?\\d{6}$"
    },
    "otcCode": {
      "description": "6 位场外基金代码，不带市场前缀。场内 ETF 属股票轨，填在 stock.positions。",
      "type": "string",
      "pattern": "^\\d{6}$"
    },
    "stockTrack": {
      "description": "股票轨：场内可交易标的。允许 available 可用量与网格参数，可分批可做 T。",
      "type": "object",
      "additionalProperties": false,
      "required": ["positions", "grid"],
      "properties": {
        "positions": { "type": "array", "items": { "$ref": "#/definitions/stockPosition" } },
        "grid": { "type": "array", "items": { "$ref": "#/definitions/gridSpec" } }
      }
    },
    "fundTrack": {
      "description": "基金轨：场外基金。无挂单无中间态，动作只有买入/卖出/调整定投三种。禁任何网格键。",
      "type": "object",
      "additionalProperties": false,
      "required": ["positions", "plans"],
      "properties": {
        "positions": { "type": "array", "items": { "$ref": "#/definitions/fundPosition" } },
        "plans": { "type": "array", "items": { "$ref": "#/definitions/fundPlan" } }
      }
    },
    "stockPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "listing", "shares", "cost"],
      "properties": {
        "code": { "$ref": "#/definitions/exchangeCode" },
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "listing": { "const": "exchange" },
        "shares": { "description": "持仓份额（股/份）。", "type": "integer", "minimum": 0 },
        "available": {
          "description": "可用份额。T+1 冻结时可用 < 持仓；缺省视为等于 shares。",
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "description": "持仓成本价（元）。允许 0 表示成本未知，此时不得参与盈亏计算。",
          "type": "number",
          "minimum": 0
        },
        "note": { "type": "string", "maxLength": 200 }
      }
    },
    "gridSpec": {
      "description": "网格参数。仅场内标的可用（ADR-007 §2.2：场外基金没有挂单与条件单，不存在中间态）。非网格标的用 enabled:false 表达，保留底仓上下限留档，不删除。",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "listing", "enabled"],
      "properties": {
        "code": { "$ref": "#/definitions/exchangeCode" },
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "listing": { "const": "exchange" },
        "enabled": {
          "description": "是否运行网格。false = 仅底仓长线持有，此时区间/步长可全为 null。",
          "type": "boolean"
        },
        "base_price": { "description": "基准价（元），网格中枢。", "type": "number", "exclusiveMinimum": 0 },
        "range_low": { "description": "价格区间下沿（元）。必须 < range_high。", "type": "number", "exclusiveMinimum": 0 },
        "range_high": { "description": "价格区间上沿（元）。", "type": "number", "exclusiveMinimum": 0 },
        "step_pct": { "description": "网格步长（%），如 2.5 表示 2.5%。不含 % 号。", "type": "number", "exclusiveMinimum": 0, "maximum": 50 },
        "per_trade": { "description": "单笔委托数量（股/份）。", "type": "integer", "exclusiveMinimum": 0 },
        "min_position": { "description": "最小底仓（股/份），触及即停卖。", "type": "integer", "minimum": 0 },
        "max_position": { "description": "最大顶仓（股/份）。", "type": "integer", "minimum": 0 },
        "guide": { "description": "操作指引原文。", "type": "string", "maxLength": 200 }
      }
    },
    "fundPosition": {
      "description": "场外基金持仓。禁网格键（base_price/range_low/range_high/step_pct/per_trade/min_position/max_position）——出现即校验失败。",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "listing", "amount"],
      "properties": {
        "code": { "$ref": "#/definitions/otcCode" },
        "name": { "type": "string", "minLength": 1, "maxLength": 48 },
        "listing": { "const": "otc" },
        "amount": { "description": "持有金额（元）。", "type": "number", "minimum": 0 },
        "holding_period_days": {
          "description": "赎回费免收窗口（天）。场外独有：赎回费按持有天数档位计。填该基金免赎回费所需天数；不确定留空。",
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        },
        "plan": {
          "description": "定投方式。regular=普通定投 smart=智慧定投 smart_take_profit=智慧止盈定投 holding=定投持仓（无在途） none=无计划。",
          "type": "string",
          "enum": ["regular", "smart", "smart_take_profit", "holding", "none"],
          "default": "none"
        },
        "note": { "type": "string", "maxLength": 200 }
      }
    },
    "fundPlan": {
      "description": "定投计划。基金轨的「节奏」由定投日历驱动，而非日内网格。",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "type"],
      "properties": {
        "code": { "$ref": "#/definitions/otcCode" },
        "type": {
          "type": "string",
          "enum": ["regular", "smart", "smart_take_profit", "holding", "none"]
        },
        "amount_per_period": { "description": "每期金额下限（元）。", "type": "number", "minimum": 0 },
        "amount_per_period_max": {
          "description": "每期金额上限（元）。智慧定投在区间内浮动，此时填写；固定金额留空。",
          "type": "number",
          "minimum": 0
        },
        "day_of_month": {
          "description": "每月扣款日。上界 28 而非 30/31：短月不存在该日期，定投日必须可实现。",
          "type": "integer",
          "minimum": 1,
          "maximum": 28
        },
        "note": { "type": "string", "maxLength": 200 }
      }
    },
    "goldItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "amount"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 48 },
        "amount": { "description": "持有金额（元），单列统计，不并入 fund_amount。", "type": "number", "minimum": 0 },
        "note": { "type": "string", "maxLength": 200 }
      }
    }
  }
}